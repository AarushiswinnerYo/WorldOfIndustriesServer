 {
     "builds": [
         {
             "src": "api/mailMe.py",
             "use": "@vercel/python"
         }
     ],
     "routes": [
         {
             "src": "/(.*)",
             "dest": "api/mailMe.py"
         }
     ],
     "functions": [
        {
            "api/mailMe.py": {
                "includeFiles": [
                    "api/verCodes.py",
                    "api/verEmails.py"
                ]
            }
        }
     ]
 }
